# ==============================================================================
# GŁÓWNE USTAWIENIA SYSTEMU STREAMFORGE
# ==============================================================================
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Zarządzanie tokenami NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=twoj_32_znakowy_klucz_szyfrujacy_w_formacie_hex

# ==============================================================================
# INTEGRACJE Z PLATFORMAMI (WĘZŁY CREDENTIAL OAUTH 2.0)
# ==============================================================================
# Twitch API
TWITCH_CLIENT_ID=identyfikator_klienta_twitch
TWITCH_CLIENT_SECRET=sekret_klienta_twitch

# YouTube / Google Cloud Console
GOOGLE_CLIENT_ID=identyfikator_oauth_google
GOOGLE_CLIENT_SECRET=sekret_oauth_google

# Kick API
KICK_CLIENT_ID=identyfikator_aplikacji_kick
KICK_CLIENT_SECRET=sekret_aplikacji_kick

# Meta / Facebook Business
FACEBOOK_CLIENT_ID=identyfikator_aplikacji_facebook
FACEBOOK_CLIENT_SECRET=sekret_aplikacji_facebook

# TikTok Developer Ecosystem
TIKTOK_CLIENT_KEY=klucz_programisty_tiktok
TIKTOK_CLIENT_SECRET=sekret_programisty_tiktok

# Discord Developer Portal
DISCORD_CLIENT_ID=identyfikator_aplikacji_discord
DISCORD_CLIENT_SECRET=sekret_aplikacji_discord

# ==============================================================================
# WARSTWA DANYCH (POSTGRESQL & CACHE REDIS)
# ==============================================================================
# Główny ciąg połączenia z bazą danych (np. PgBouncer pooling)
DATABASE_URL=postgresql://user:password@host:5432/streamforge?pgbouncer=true

# Bezpośrednie połączenie do wykonywania migracji strukturalnych
DIRECT_URL=postgresql://user:password@host:5432/streamforge

# Serverless Redis (Upstash) do obsługi Rate Limiting i Cache Tokenów
UPSTASH_REDIS_REST_URL=https://twoj-wezel-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=twoj_token_dostepu_upstash_rest

# ==============================================================================
# AGENCI SZTUCZNEJ INTELIGENCJI (AI AGENTS)
# ==============================================================================
# OpenAI API Engine
OPENAI_API_KEY=sk-proj-twojKluczProdukcyjnyOpenAI

# Google Gemini API Matrix
GEMINI_API_KEY=AIzaSyTwojKluczProdukcyjnyGemini

# ==============================================================================
# PRZECHOWYWANIE PLIKÓW BINARNYCH (MEDIA STORAGE)
# ==============================================================================
# Vercel Blob / Cloudflare R2 Gateway Token
BLOB_READ_WRITE_TOKEN=token_zapisu_odczytu_vercel_blob

# ==============================================================================
# PROCESY MONETYZACJI I TRANSAKCJI STRIPE
# ==============================================================================
STRIPE_SECRET_KEY=sk_test_twojKluczPrywatnyStripe
STRIPE_WEBHOOK_SECRET=whsec_twojSekretSzyfrujacyWebhookaStripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_twojKluczPublicznyStripe

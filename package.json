{
  "name": "streamforge",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "pnpm prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"**/*.{json,md}\"",
    "typecheck": "pnpm tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "node prisma/seed.js",
    "db:reset": "prisma migrate reset --force",
    "analyze": "cross-env ANALYZE=true pnpm build",
    "prepare": "husky install",
    "postinstall": "pnpm prisma generate"
  },
  "dependencies": {
    "@auth/prisma-adapter": "2.0.0",
    "@dnd-kit/core": "6.1.0",
    "@dnd-kit/sortable": "8.0.0",
    "@prisma/client": "5.12.1",
    "@tanstack/react-query": "5.28.14",
    "@trpc/client": "11.0.0-next.324",
    "@trpc/react-query": "11.0.0-next.324",
    "@trpc/server": "11.0.0-next.324",
    "@upstash/ratelimit": "1.0.3",
    "@upstash/redis": "1.29.0",
    "clsx": "2.1.0",
    "framer-motion": "11.0.24",
    "lucide-react": "0.363.0",
    "next": "15.2.5",
    "next-auth": "5.0.0-beta.15",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "recharts": "2.12.3",
    "tailwind-merge": "2.2.2",
    "zod": "3.22.4",
    "zustand": "4.5.2"
  },
  "devDependencies": {
    "@commitlint/cli": "19.2.1",
    "@commitlint/config-conventional": "19.1.0",
    "@tailwindcss/forms": "0.5.7",
    "@types/node": "20.11.30",
    "@types/react": "18.2.73",
    "@types/react-dom": "18.2.22",
    "@typescript-eslint/eslint-plugin": "7.4.0",
    "@typescript-eslint/parser": "7.4.0",
    "@vitejs/plugin-react": "4.3.0",
    "@vitest/coverage-v8": "1.4.0",
    "@testing-library/react": "14.0.0",
    "@next/bundle-analyzer": "15.2.5",
    "autoprefixer": "10.4.19",
    "cross-env": "7.0.3",
    "eslint": "8.57.0",
    "eslint-config-next": "15.2.5",
    "eslint-plugin-import": "2.30.0",
    "husky": "9.0.11",
    "jsdom": "24.0.0",
    "lint-staged": "15.2.2",
    "postcss": "8.4.38",
    "prettier": "3.2.5",
    "prettier-plugin-tailwindcss": "0.5.13",
    "prisma": "5.12.1",
    "tailwindcss": "3.4.1",
    "tailwindcss-animate": "1.0.7",
    "typescript": "5.4.3",
    "vitest": "1.4.0",
    "webpack-bundle-analyzer": "4.10.1"
  }
}
